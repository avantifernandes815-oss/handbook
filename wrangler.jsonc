// Test copy of the Momence SDR Handbook with certifications.
// Live handbook is a separate Worker (momence-sdr-handbook) and is not touched by this config.
{
  "name": "sdr-handbook-test",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first, so nothing is served without a verified sign-in.
    "run_worker_first": true
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "sdr-certifications-test", "database_id": "4809e943-0ebb-419d-a6ee-1c369e1ee9b7", "migrations_dir": "migrations"}
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://fancy-grass-2946.cloudflareaccess.com",
    "ACCESS_AUD": "337c9135a6fb4beeb0004475b076de90d28812e24f0e30823dc5d6251c131e4a",
    "HANDBOOK_OWNER_EMAIL": "avanti.fernandes1@gmail.com"
  },
  "observability": {"enabled": true}
}
